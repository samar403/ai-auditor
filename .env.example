# Required in production: a long random string (openssl rand -base64 32)
AUTH_SECRET=

# Claude powers analysis, gap checks, report narratives and the assistant.
# Leave empty to run in offline mode with the built-in keyword engine.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5
# ANTHROPIC_MODEL=claude-opus-5-5

# SQLite file locally; use a libsql:// URL + token for Turso in production
DATABASE_URL=file:./data/ai-auditor.db
# DATABASE_AUTH_TOKEN=

# Protects /api/cron/sync (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Identifies your crawler to regulators' RSS endpoints (SEC requires contact info)
FEED_USER_AGENT="AI Auditor compliance monitor (contact: you@example.com)"

# Set to false to skip the demo workspace on first setup
# SEED_DEMO=false
